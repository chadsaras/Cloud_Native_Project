# Copy to .env and change the passwords before running anything that is
# reachable from outside localhost.
#
# .env is gitignored. These defaults exist so `make up` works out of the box on
# a laptop; they are not safe anywhere else.

ELASTIC_PASSWORD=changeme-local-only
KIBANA_PASSWORD=changeme-local-only

# Must be at least 32 characters and must stay stable across restarts. Kibana
# encrypts detection-rule state with it; change it and every installed rule
# becomes undecryptable and has to be reinstalled.
KIBANA_ENCRYPTION_KEY=a-32-character-or-longer-local-key-0001
